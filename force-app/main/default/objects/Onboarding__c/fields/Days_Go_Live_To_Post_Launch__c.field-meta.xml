<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Go_Live_To_Post_Launch__c</fullName>
    <description>Calendar days between first reaching Go_Live and first reaching Post_Launch_Review. Blank until both dates exist.</description>
    <formula>ROUND(Post_Launch_Review_Reached_On__c - Go_Live_Reached_On__c, 1)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days: Go Live to Post-Launch</label>
    <precision>18</precision>
    <required>false</required>
    <scale>1</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
