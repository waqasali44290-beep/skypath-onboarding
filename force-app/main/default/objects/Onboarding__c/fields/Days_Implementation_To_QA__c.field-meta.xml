<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Implementation_To_QA__c</fullName>
    <description>Calendar days between first reaching Implementation and first reaching QA_Review. Blank until both dates exist.</description>
    <formula>ROUND(QA_Review_Reached_On__c - Implementation_Reached_On__c, 1)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days: Implementation to QA</label>
    <precision>18</precision>
    <required>false</required>
    <scale>1</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
