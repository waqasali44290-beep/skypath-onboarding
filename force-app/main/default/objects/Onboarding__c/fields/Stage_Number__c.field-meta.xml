<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Stage_Number__c</fullName>
    <description>Position of the current stage in the process (1-6). Used by validation rules and page visibility rules.</description>
    <formula>CASE(Stage__c,
    &quot;Kickoff_Scheduled&quot;, 1,
    &quot;Gathering_Info&quot;, 2,
    &quot;Implementation&quot;, 3,
    &quot;QA_Review&quot;, 4,
    &quot;Go_Live&quot;, 5,
    &quot;Post_Launch_Review&quot;, 6,
    0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Stage Number</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
